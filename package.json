{
  "name": "claudex",
  "version": "0.1.0",
  "description": "Turn-based pair programming protocol between AI CLI agents (claude, codex, agy)",
  "type": "module",
  "private": true,
  "scripts": {
    "check": "bun run lint && bun run depcruise && bun run typecheck && bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --no-error-on-unmatched-pattern",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "test": "bun test",
    "build": "bun build --compile --outfile dist/pair src/apps/cli/main.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "dependency-cruiser": "^16.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
